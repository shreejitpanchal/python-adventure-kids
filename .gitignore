# Virtual environment
.venv/
venv/
env/

# Python bytecode / cache
__pycache__/
*.py[cod]
*$py.class

# Packaging / build artifacts (relevant once PyInstaller packaging lands)
build/
dist/
*.egg-info/
*.egg

# Test / coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Editors / IDEs
.vscode/
.idea/
*.swp

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log

# Local app data -- settings.json, progress.sqlite3, a real child's name,
# PIN hash, etc. Lives in the repo for dev convenience (see
# app/config/settings.py) but must never be committed.
/app-data/
*.sqlite3
*.sqlite3-journal
