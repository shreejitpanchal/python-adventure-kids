# Virtual environment
.venv/
venv/
env/

# Python bytecode / cache
__pycache__/
*.py[cod]
*$py.class

# Packaging / build artifacts (relevant once PyInstaller packaging lands)
build/
dist/
*.egg-info/
*.egg

# Test / coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Editors / IDEs
.vscode/
.idea/
*.swp

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log

# Local app data should never live in the repo -- the real app writes to
# %APPDATA%\PythonAdventure\, but just in case anything lands here during
# local testing:
*.sqlite3
*.sqlite3-journal
